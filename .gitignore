# Never commit artifacts — Drive is their source of truth
*.pptx
*.gslides
*.gdoc
*.gsheet
*.docx
*.xlsx
*.zip

# Local working output
deck_work/
*_inventory_*.csv
*.bak

# Credentials — never commit
*.json
!package.json
!pipeline_invariants.json
credentials*
token*
.env

# OS noise
.DS_Store

# Rescued governing documents from the Red Clay school drive (2026-08-29).
# The blanket artifact rules above stay — these are scoped exceptions for
# documents whose only other copy is on a district account with a clock on it.
!docs/tpt/originals/*.docx
!docs/tpt/originals/*.xlsx

# Audit outputs are records, not working output. The *_inventory_*.csv rule above
# is for scratch inventories; these are kept deliberately. (2026-08-29)
!audits/*.csv
